# Kopieer naar .env en vul aan.
# Lokale database: start eerst `npx prisma dev --name timeless`
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Auth.js — genereer een echte secret met: npx auth secret
AUTH_SECRET="vervang-dit"
AUTH_TRUST_HOST="true"
